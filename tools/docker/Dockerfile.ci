# linux/arm64 toolchain matching CI (.github/workflows/fork-ci.yml: Go 1.27.2).
# The one place to bump: GO_VERSION and the digest of its multi-arch index
# (docker buildx imagetools inspect golang:<version>-bookworm).
ARG GO_VERSION=1.27.2
FROM golang:${GO_VERSION}-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61
ENV GOFLAGS=-modcacherw GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
