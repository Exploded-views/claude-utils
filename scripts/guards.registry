# Every "may we proceed?" guard in scripts/bootstrap.sh. One per line:
#   <name> <tools it runs, space separated, or ->
# A guard is the function <name>_check; it prints "SAFE:<name>" only on an
# explicitly safe outcome, and run through guard/guard_ok anything else
# (another exit code, a missing token, extra output, a signal, a timeout)
# is a refusal. scripts/guard_fault_test.sh injects faults into each guard
# (it needs a fixture_<name> function there); scripts/lint-guards.sh checks
# that the registry, the guard calls, the functions and the fixtures agree.
git_dir git
git_stash git
git_unpushed git
git_clean_tree git
git_idle git
daemon_lock python3
routes_unnamed python3
sync_dir_ours -
repo_private python3
token_file_ok stat id
check_key_ok stat id
org_not_kept_out tr
repo_name_ok -
host_key_fp ssh-keygen awk
no_old_config python3
no_predecessor_units systemctl
recovery_key_ok -
key_free -
project_not_kept_out -
